            "dataType": "int64",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64"
          },
          {
            "name": "Month",
            "dataType": "int64"
          },
          {
            "name": "MonthName",
            "dataType": "string"
          },
          {
            "name": "Quarter",
            "dataType": "int64"
          },
          {
            "name": "DayOfWeek",
            "dataType": "int64"
          }
        ],
        "partitions": [
          {
            "name": "DimDate-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"D:/RR_PRESSURE_INDEX_2027/dashboard/data/dim_date.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.None]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])\nin\n    Promoted"
            }
          }
        ]
      },
