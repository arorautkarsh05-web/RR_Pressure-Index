{
  "name": "RR_Auction_Intelligence_2027",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "RowKey",
            "dataType": "int64",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table({\"RowKey\"}, {{1}})\nin\n    Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Deliveries Faced",
            "expression": "CALCULATE(\n    COUNTROWS(FactDeliveryPressure),\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Total Deliveries Bowled",
            "expression": "CALCULATE(\n    COUNTROWS(FactDeliveryPressure),\n    FactDeliveryPressure[IsLegalBowling] = 1,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Pressure Deliveries Faced",
            "expression": "CALCULATE(\n    [Total Deliveries Faced],\n    FactDeliveryPressure[IsBatPressure] = 1\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Leverage Deliveries Bowled",
            "expression": "CALCULATE(\n    [Total Deliveries Bowled],\n    FactDeliveryPressure[IsBowlLeverage] = 1\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Normal Deliveries Faced",
            "expression": "CALCULATE(\n    [Total Deliveries Faced],\n    FactDeliveryPressure[IsBatPressure] = 0\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Normal Deliveries Bowled",
            "expression": "CALCULATE(\n    [Total Deliveries Bowled],\n    FactDeliveryPressure[IsBowlLeverage] = 0\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Pressure Exposure Share Bat %",
            "expression": "DIVIDE(\n    [Pressure Deliveries Faced],\n    [Total Deliveries Faced],\n    BLANK()\n)",
            "displayFolder": "1. VOLUME & BALL COUNT MEASURES",
            "description": ""
          },
          {
            "name": "Leverage Exposure Share Bowl %",
            "expression": "DIVIDE(\n    [Leverage Deliveries Bowled],\n    [Total Deliveries Bowled],\n    BLANK()\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Total Runs Scored",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[RunsBat]),\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Pressure Runs Scored",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[RunsBat]),\n    FactDeliveryPressure[IsBatPressure] = 1,\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Normal Runs Scored",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[RunsBat]),\n    FactDeliveryPressure[IsBatPressure] = 0,\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Total Bowler Runs Conceded",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[BowlerRunsConceded]),\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Leverage Runs Conceded",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[BowlerRunsConceded]),\n    FactDeliveryPressure[IsBowlLeverage] = 1,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Normal Runs Conceded",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[BowlerRunsConceded]),\n    FactDeliveryPressure[IsBowlLeverage] = 0,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Pressure Dismissals",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[IsWicket]),\n    FactDeliveryPressure[IsBatPressure] = 1,\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "2. RUNS & DISMISSAL AGGREGATIONS",
            "description": ""
          },
          {
            "name": "Leverage Wickets Taken",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[IsBowlerWicket]),\n    FactDeliveryPressure[IsBowlLeverage] = 1,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Pressure Strike Rate",
            "expression": "DIVIDE(\n    [Pressure Runs Scored] * 100.0,\n    [Pressure Deliveries Faced],\n    BLANK()\n)",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Normal Baseline Strike Rate",
            "expression": "DIVIDE(\n    [Normal Runs Scored] * 100.0,\n    [Normal Deliveries Faced],\n    BLANK()\n)",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Delta Context Strike Rate",
            "expression": "[Pressure Strike Rate] - [Normal Baseline Strike Rate]",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Leverage Economy Rate",
            "expression": "DIVIDE(\n    [Leverage Runs Conceded] * 6.0,\n    [Leverage Deliveries Bowled],\n    BLANK()\n)",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Normal Baseline Economy Rate",
            "expression": "DIVIDE(\n    [Normal Runs Conceded] * 6.0,\n    [Normal Deliveries Bowled],\n    BLANK()\n)",
            "displayFolder": "3. PERFORMANCE RATES & SCORING VELOCITY",
            "description": ""
          },
          {
            "name": "Delta Context Economy Rate",
            "expression": "[Leverage Economy Rate] - [Normal Baseline Economy Rate]",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Pressure Boundaries Hit",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[IsFour]) + SUM(FactDeliveryPressure[IsSix]),\n    FactDeliveryPressure[IsBatPressure] = 1,\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Pressure Boundary %",
            "expression": "DIVIDE(\n    [Pressure Boundaries Hit],\n    [Pressure Deliveries Faced],\n    BLANK()\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Pressure Dots Faced",
            "expression": "CALCULATE(\n    COUNTROWS(FactDeliveryPressure),\n    FactDeliveryPressure[IsBatPressure] = 1,\n    FactDeliveryPressure[RunsBat] = 0,\n    FactDeliveryPressure[IsLegalBatting] = 1\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Pressure Dot %",
            "expression": "DIVIDE(\n    [Pressure Dots Faced],\n    [Pressure Deliveries Faced],\n    BLANK()\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Leverage Boundaries Conceded",
            "expression": "CALCULATE(\n    SUM(FactDeliveryPressure[IsFour]) + SUM(FactDeliveryPressure[IsSix]),\n    FactDeliveryPressure[IsBowlLeverage] = 1,\n    FactDeliveryPressure[IsLegalBowling] = 1,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Leverage Conceded Boundary %",
            "expression": "DIVIDE(\n    [Leverage Boundaries Conceded],\n    [Leverage Deliveries Bowled],\n    BLANK()\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Leverage Dots Bowled",
            "expression": "CALCULATE(\n    COUNTROWS(FactDeliveryPressure),\n    FactDeliveryPressure[IsBowlLeverage] = 1,\n    FactDeliveryPressure[BowlerRunsConceded] = 0,\n    FactDeliveryPressure[IsLegalBowling] = 1,\n    USERELATIONSHIP(DimPlayer[PlayerID], FactDeliveryPressure[BowlerID])\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Leverage Dot %",
            "expression": "DIVIDE(\n    [Leverage Dots Bowled],\n    [Leverage Deliveries Bowled],\n    BLANK()\n)",
            "displayFolder": "4. BOUNDARY & DOT-BALL RATIOS",
            "description": ""
          },
          {
            "name": "Leverage Wicket Strike Rate",
            "expression": "DIVIDE(\n    [Leverage Deliveries Bowled],\n    [Leverage Wickets Taken],\n    BLANK()\n)",
            "displayFolder": "5. BAYESIAN POSTERIOR METRICS & UNCERTAINTY BOUNDS",
            "description": ""
          },
          {
            "name": "Bayes Estimate Rate",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[BayesEstimate])",
            "displayFolder": "5. BAYESIAN POSTERIOR METRICS & UNCERTAINTY BOUNDS",
            "description": ""
          },
          {
            "name": "Bayes CI Low",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[Bayes_CI_Low])",
            "displayFolder": "5. BAYESIAN POSTERIOR METRICS & UNCERTAINTY BOUNDS",
            "description": ""
          },
          {
            "name": "Bayes CI High",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[Bayes_CI_High])",
            "displayFolder": "5. BAYESIAN POSTERIOR METRICS & UNCERTAINTY BOUNDS",
            "description": ""
          },
          {
            "name": "Bayes CI Width",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[Bayes_CI_Width])",
            "displayFolder": "5. BAYESIAN POSTERIOR METRICS & UNCERTAINTY BOUNDS",
            "description": ""
          },
          {
            "name": "Bayes Error Margin",
            "expression": "DIVIDE([Bayes CI Width], 2.0, BLANK())",
            "displayFolder": "6. OFFICIAL CPRI & DYNAMIC COMPOSITE SCORES",
            "description": ""
          },
          {
            "name": "Official CPRI Score",
            "expression": "SELECTEDVALUE(DimRanking[CPRI])",
            "displayFolder": "6. OFFICIAL CPRI & DYNAMIC COMPOSITE SCORES",
            "description": ""
          },
          {
            "name": "CPRI CI Low",
            "expression": "SELECTEDVALUE(DimRanking[CPRI_CI_Low])",
            "displayFolder": "6. OFFICIAL CPRI & DYNAMIC COMPOSITE SCORES",
            "description": ""
          },
          {
            "name": "CPRI CI High",
            "expression": "SELECTEDVALUE(DimRanking[CPRI_CI_High])",
            "displayFolder": "6. OFFICIAL CPRI & DYNAMIC COMPOSITE SCORES",
            "description": ""
          },
          {
            "name": "CPRI Error Bar Length",
            "expression": "DIVIDE([CPRI CI High] - [CPRI CI Low], 2.0, BLANK())",
            "displayFolder": "7. MATCH-LEVEL CONSISTENCY & OUTLIER JACKKNIFE",
            "description": ""
          },
          {
            "name": "Match Level CV",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[MatchCV])",
            "displayFolder": "7. MATCH-LEVEL CONSISTENCY & OUTLIER JACKKNIFE",
            "description": ""
          },
          {
            "name": "Match Success Rate %",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[MatchSuccessRate])",
            "displayFolder": "7. MATCH-LEVEL CONSISTENCY & OUTLIER JACKKNIFE",
            "description": ""
          },
          {
            "name": "Jackknife Worst Case Metric",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[JackknifeWorstCaseMetric])",
            "displayFolder": "7. MATCH-LEVEL CONSISTENCY & OUTLIER JACKKNIFE",
            "description": ""
          },
          {
            "name": "Jackknife SE",
            "expression": "SELECTEDVALUE(FactPlayerPressurePerformance[JackknifeSE])",
            "displayFolder": "7. MATCH-LEVEL CONSISTENCY & OUTLIER JACKKNIFE",
            "description": ""
          },
          {
            "name": "Jackknife Degradation Delta",
            "expression": "ABS([Bayes Estimate Rate] - [Jackknife Worst Case Metric])",
            "displayFolder": "8. AUCTION EVIDENCE & VALUATION MEASURES",
            "description": ""
          },
          {
            "name": "Auction Evidence Tier",
            "expression": "SELECTEDVALUE(DimRanking[OverallEvidenceTier])",
            "displayFolder": "8. AUCTION EVIDENCE & VALUATION MEASURES",
            "description": ""
          },
          {
            "name": "Sample Confidence Class",
            "expression": "SELECTEDVALUE(DimRanking[ConfidenceClass])",
            "displayFolder": "8. AUCTION EVIDENCE & VALUATION MEASURES",
            "description": ""
          },
          {
            "name": "Player Official Rank",
            "expression": "SELECTEDVALUE(DimRanking[OfficialRank])",
            "displayFolder": "8. AUCTION EVIDENCE & VALUATION MEASURES",
            "description": ""
          },
          {
            "name": "Auction Purse Multiplier Range",
            "expression": "SWITCH(\n    [Player Official Rank],\n    1, \"2.5x - 3.0x Baseline\",\n    2, \"2.5x - 3.0x Baseline\",\n    3, \"2.5x - 3.0x Baseline\",\n    4, \"2.2x - 2.5x Baseline\",\n    5, \"1.8x - 2.2x Baseline\",\n    6, \"1.8x - 2.2x Baseline\",\n    7, \"1.8x - 2.2x Baseline\",\n    8, \"1.5x - 1.8x Baseline\",\n    9, \"1.5x - 1.8x Baseline\",\n    10, \"1.2x - 1.5x Baseline\",\n    \"1.0x Baseline\"\n)",
            "displayFolder": "9. DYNAMIC UI & CARD TITLE FORMATTERS",
            "description": ""
          },
          {
            "name": "Selected Player Name",
            "expression": "SELECTEDVALUE(DimPlayer[PlayerName], \"Select a Player\")",
            "displayFolder": "9. DYNAMIC UI & CARD TITLE FORMATTERS",
            "description": ""
          },
          {
            "name": "Selected Player Header Text",
            "expression": "VAR PlayerName = SELECTEDVALUE(DimPlayer[PlayerName], \"League Overview\")\nVAR Disc = SELECTEDVALUE(DimRanking[Discipline], \"\")\nVAR RankNum = SELECTEDVALUE(DimRanking[OfficialRank], 0)\nRETURN\nIF(\n    RankNum > 0,\n    PlayerName & \" (Rank #\" & RankNum & \" \" & Disc & \" | CPRI: \" & FORMAT([Official CPRI Score], \"0.00\") & \")\",\n    PlayerName\n)",
            "displayFolder": "9. DYNAMIC UI & CARD TITLE FORMATTERS",
            "description": ""
          },
          {
            "name": "Linguistic Governance Status",
            "expression": "SWITCH(\n    [Player Official Rank],\n    1, \"Certified Top 10 Contender (Leading Tier)\",\n    2, \"Certified Top 10 Contender (Elite Core)\",\n    3, \"Certified Top 10 Asset\",\n    4, \"Certified Top 10 Asset\",\n    5, \"Certified Top 10 Asset\",\n    \"Certified Tactical Asset\"\n)",
            "displayFolder": "9. DYNAMIC UI & CARD TITLE FORMATTERS",
            "description": ""
          }
        ]
      },
      {
        "name": "DimCompetition",
        "columns": [
          {
            "name": "CompID",
            "dataType": "int64",
            "isKey": true
          },
          {
            "name": "CompName",
            "dataType": "string"
          },
          {
            "name": "MatchFormat",
            "dataType": "string"
          },
          {
            "name": "Season",
            "dataType": "int64"
          },
          {
            "name": "CompetitionType",
            "dataType": "string"
          }
        ],
        "partitions": [
          {
            "name": "DimCompetition-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"D:/RR_PRESSURE_INDEX_2027/dashboard/data/dim_competition.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.None]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])\nin\n    Promoted"
            }
          }
        ]
      },
