          },
          {
            "name": "IsBatPressure",
            "dataType": "int64"
          },
          {
            "name": "IsBowlLeverage",
            "dataType": "int64"
          },
          {
            "name": "Description",
            "dataType": "string"
          }
        ],
        "partitions": [
          {
            "name": "DimContext-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"D:/RR_PRESSURE_INDEX_2027/dashboard/data/dim_context.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.None]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])\nin\n    Promoted"
            }
          }
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime"
          },
          {
